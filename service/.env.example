# Environment variables for the enrichment service.
# Local development: copy this file to .env.local in this folder and fill it in.
# Deployments: set the same variables in the Vercel project.
# Never commit real values.

# Bearer token n8n sends to POST /api/enrich. At least 32 characters; use a long random
# value, for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENRICH_API_TOKEN=

# Which platform serves Claude, and the model or inference profile ID as that platform
# names it. Only "bedrock" is implemented, and the ID must be one that llm/pricing.ts
# has a price for.
LLM_PROVIDER=bedrock
LLM_MODEL_ID=

# Amazon Bedrock: the region, and an IAM access key pair allowed only bedrock:InvokeModel
# on the inference profile above and the foundation models it routes to. These use their
# own BEDROCK_* names because Vercel can inject AWS_* values that are not ours; the service
# never reads AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY or AWS_SESSION_TOKEN.
# Do not set AWS_BEARER_TOKEN_BEDROCK: the SDK would prefer it over these keys, so the
# service refuses to start when it is present.
BEDROCK_REGION=us-east-1
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
