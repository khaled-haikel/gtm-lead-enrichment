# Environment variables for the enrichment service.
# Local development: copy this file to .env.local in this folder and fill it in.
# Deployments: set the same variables in the Vercel project.
# Never commit real values.

# Bearer token n8n sends to POST /api/enrich. Use a long random value,
# for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENRICH_API_TOKEN=

# Which platform serves Claude (the Anthropic API or Amazon Bedrock), and the model ID
# as that platform names it.
LLM_PROVIDER=
LLM_MODEL_ID=

# Provider credentials. Uncomment only the block for the chosen LLM_PROVIDER.

# Anthropic API
# ANTHROPIC_API_KEY=

# Amazon Bedrock: a Bedrock API key, or an IAM access key pair
# AWS_REGION=
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
